---
import Base from "../../layouts/Base.astro";
import { roster, stats, positionOf, displayNumber } from "../../lib/data";

const hasStatus = (k) => roster.some((p) => (p.status ?? "") === k);

const filters = [
  { key: "all", label: "全部", n: roster.length },
  { key: "active", label: "现役", n: roster.filter((p) => p.status === "active").length },
  { key: "retired", label: "退役", n: roster.filter((p) => p.status === "retired").length },
].filter((f) => f.key === "all" || f.n > 0);
---

<Base
  title="名单"
  description={`${stats.players} 名球员的号码、位置与现役状态，按号码排列。`}
  active="squad"
>
  <section class="wrap">
    <div class="page-head">
      <p class="label page-head__kicker">Squad · 名单</p>
      <h1>{stats.players} 名球员</h1>
    </div>

    <div class="section section--tight">
      <div class="filters" role="group" aria-label="筛选">
        {
          filters.map((f) => (
            <button
              type="button"
              class="filter"
              data-filter={f.key}
              aria-pressed={f.key === "all" ? "true" : "false"}
            >
              {f.label}
              <span class="filter__n">{f.n}</span>
            </button>
          ))
        }
      </div>

      <div class="roster">
        {
          roster.map((p) => (
            <a
              class="player"
              href={p.number != null ? `/squad/${p.number}` : undefined}
              data-status={p.status ?? ""}
              aria-label={`${p.name}${positionOf(p) ? "，" + positionOf(p) : ""}`}
            >
              <span class="player__row">
                <span class="num player__num">{displayNumber(p)}</span>
                <span class="player__pos">{positionOf(p) ?? ""}</span>
              </span>
              <span class="player__name">{p.name}</span>
              {p.status ? (
                <span class="player__status" data-status={p.status}>
                  {p.status === "active" ? "现役" : "退役"}
                </span>
              ) : null}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll(".filter");
    const cards = document.querySelectorAll(".roster .player");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.filter;
        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b === btn))
        );
        cards.forEach((card) => {
          const show = key === "all" || card.dataset.status === key;
          card.hidden = !show;
        });
      });
    });
  </script>
</Base>
