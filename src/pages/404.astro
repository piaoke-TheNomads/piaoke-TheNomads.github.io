---
import Base from "../layouts/Base.astro";
---

<Base title="页面没找到">
  <section class="wrap">
    <div class="page-head">
      <p class="label page-head__kicker">404</p>
      <h1>这页不在场上</h1>
      <p class="lede page-head__dek">
        链接可能过期了，或者号码填错了。
      </p>
      <p style="margin-top:26px"><a class="btn" href="/">回首页</a></p>
    </div>
  </section>
</Base>
