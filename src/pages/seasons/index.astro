---
import Base from "../../layouts/Base.astro";
import { seasonsList, stats } from "../../lib/data";
---

<Base
  title="赛季"
  description={`球门飘客参加过的 ${stats.seasons} 个赛季的场次、名次与结果。`}
  active="seasons"
>
  <section class="wrap">
    <div class="page-head">
      <p class="label page-head__kicker">Seasons · 赛季</p>
      <h1>{stats.seasons} 个赛季</h1>
      <p class="lede page-head__dek">
        场次与名次来自赛事积分榜。逐场比分还在整理，胜负战绩补齐后会出现在各赛季页。
      </p>
    </div>

    <div class="section section--tight">
      <table class="table">
        <thead>
          <tr>
            <th>赛季</th>
            <th class="num">场次</th>
            <th class="num">名次</th>
            <th>结果</th>
          </tr>
        </thead>
        <tbody>
          {
            seasonsList.map((s) => (
              <tr>
                <td>
                  <a href={`/seasons/${s.id}`} class="table__link">
                    {s.label}
                  </a>
                </td>
                <td class="num">{s.played ?? "—"}</td>
                <td class="num">{s.rank ?? "—"}</td>
                <td>{s.result}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>
