---
import Base from "../layouts/Base.astro";

const initialPositions = [
  { number: 1, role: "门将", x: 8, y: 50 },
  { number: 2, role: "后卫", x: 26, y: 20 },
  { number: 3, role: "后卫", x: 26, y: 50 },
  { number: 4, role: "后卫", x: 26, y: 80 },
  { number: 5, role: "中场", x: 52, y: 32 },
  { number: 6, role: "中场", x: 52, y: 68 },
  { number: 7, role: "前锋", x: 76, y: 32 },
  { number: 8, role: "前锋", x: 76, y: 68 },
];
---

<Base
  active="tactics"
  title="八人制战术板"
  description="在球场上拖动 1 至 8 号棋子，安排八人制足球战术。"
>
  <section class="section tactics-page">
    <div class="wrap">
      <div class="tactics-intro">
        <p class="label">Tactics · 战术</p>
        <h1>八人制战术板</h1>
        <p class="lede">
          把 1 至 8 号棋子拖到场上，快速排出站位。位置会保存在当前浏览器中，也可以导出给队友。
        </p>
        <p class="tactics-caption">棋子编号用于排阵，可按需要对应到实际队员。</p>
      </div>

      <div class="tactics-toolbar" aria-label="战术板操作">
        <button class="btn tactics-action" type="button" data-action="reset">恢复默认阵型</button>
        <button class="btn btn--quiet tactics-action" type="button" data-action="export">导出战术</button>
        <span class="tactics-status" role="status" aria-live="polite" data-status>已加载默认阵型</span>
      </div>

      <div class="tactics-layout">
        <div class="tactics-board-wrap">
          <div
            class="tactics-board"
            data-board
            role="application"
            aria-label="八人制足球战术板，可拖动场上的编号棋子"
          >
            <div class="tactics-field" aria-hidden="true">
              <svg class="tactics-markings" viewBox="0 0 100 64" preserveAspectRatio="none">
                <rect x="1" y="1" width="98" height="62" rx="0.8" />
                <line x1="50" y1="1" x2="50" y2="63" />
                <circle cx="50" cy="32" r="8" />
                <circle class="tactics-markings__dot" cx="50" cy="32" r="0.9" />
                <rect x="1" y="18" width="16" height="28" />
                <rect x="1" y="24" width="7" height="16" />
                <rect x="83" y="18" width="16" height="28" />
                <rect x="92" y="24" width="7" height="16" />
                <path d="M17 25 A9 9 0 0 1 17 39" />
                <path d="M83 25 A9 9 0 0 0 83 39" />
                <path d="M1 9 A8 8 0 0 0 9 1" />
                <path d="M99 9 A8 8 0 0 1 91 1" />
                <path d="M1 55 A8 8 0 0 1 9 63" />
                <path d="M99 55 A8 8 0 0 0 91 63" />
              </svg>
              <span class="tactics-goal tactics-goal--left"></span>
              <span class="tactics-goal tactics-goal--right"></span>
            </div>

            {
              initialPositions.map((player) => (
                <button
                  class="tactics-token"
                  type="button"
                  data-number={player.number}
                  data-x={player.x}
                  data-y={player.y}
                  style={`left:${player.x}%;top:${player.y}%`}
                  aria-label={`${player.number} 号，${player.role}，可拖动`}
                  title={`${player.number} 号 · ${player.role}`}
                >
                  <span class="tactics-token__number num">{player.number}</span>
                  <span class="tactics-token__role">{player.role}</span>
                </button>
              ))
            }
          </div>
          <p class="tactics-help">拖动棋子调整站位；选中棋子后可用方向键微调。</p>
        </div>

        <aside class="tactics-notes">
          <h2>使用说明</h2>
          <ol>
            <li>按住编号棋子，拖到想要的站位。</li>
            <li>在手机上直接触摸拖动；方向键可做细调。</li>
            <li>布局会自动保存在本机浏览器。点击“导出战术”下载 JSON 文件。</li>
          </ol>
          <div class="tactics-legend">
            <p class="label">默认分工</p>
            <div><span class="tactics-swatch tactics-swatch--gk"></span>1 号 · 门将</div>
            <div><span class="tactics-swatch tactics-swatch--def"></span>2–4 号 · 后卫</div>
            <div><span class="tactics-swatch tactics-swatch--mid"></span>5–6 号 · 中场</div>
            <div><span class="tactics-swatch tactics-swatch--att"></span>7–8 号 · 前锋</div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ initialPositions }}>
  const board = document.querySelector("[data-board]");
  const status = document.querySelector("[data-status]");
  const tokens = [...document.querySelectorAll(".tactics-token")];
  const storageKey = "qmpk-tactics-positions-v1";
  const defaults = initialPositions;
  let positions = Object.fromEntries(defaults.map((player) => [player.number, { x: player.x, y: player.y }]));
  let drag = null;
  let statusTimer;

  const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

  function say(message) {
    window.clearTimeout(statusTimer);
    status.textContent = message;
    statusTimer = window.setTimeout(() => {
      status.textContent = "已自动保存";
    }, 1800);
  }

  function render() {
    tokens.forEach((token) => {
      const point = positions[token.dataset.number];
      if (!point) return;
      token.style.left = `${point.x}%`;
      token.style.top = `${point.y}%`;
      token.dataset.x = point.x;
      token.dataset.y = point.y;
    });
  }

  function persist() {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(positions));
    } catch {
      // Storage can be unavailable in private or embedded browser contexts.
    }
    say("已自动保存");
  }

  function load() {
    try {
      const stored = JSON.parse(window.localStorage.getItem(storageKey) || "null");
      if (!stored || typeof stored !== "object") return;
      defaults.forEach((player) => {
        const point = stored[player.number];
        if (point && Number.isFinite(Number(point.x)) && Number.isFinite(Number(point.y))) {
          positions[player.number] = {
            x: clamp(Number(point.x), 1, 99),
            y: clamp(Number(point.y), 3, 97),
          };
        }
      });
      render();
      status.textContent = "已加载上次保存的布局";
    } catch {
      // Ignore malformed or unavailable local storage and keep defaults.
    }
  }

  function updateFromPointer(token, clientX, clientY) {
    const rect = board.getBoundingClientRect();
    const x = clamp(((clientX - rect.left) / rect.width) * 100, 1.8, 98.2);
    const y = clamp(((clientY - rect.top) / rect.height) * 100, 4, 96);
    positions[token.dataset.number] = { x: Number(x.toFixed(2)), y: Number(y.toFixed(2)) };
    render();
  }

  tokens.forEach((token) => {
    token.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      token.setPointerCapture?.(event.pointerId);
      token.classList.add("is-dragging");
      drag = { token, pointerId: event.pointerId };
    });

    token.addEventListener("pointermove", (event) => {
      if (!drag || drag.token !== token || drag.pointerId !== event.pointerId) return;
      updateFromPointer(token, event.clientX, event.clientY);
    });

    const stopDrag = (event) => {
      if (!drag || drag.token !== token || drag.pointerId !== event.pointerId) return;
      token.classList.remove("is-dragging");
      token.releasePointerCapture?.(event.pointerId);
      drag = null;
      persist();
    };

    token.addEventListener("pointerup", stopDrag);
    token.addEventListener("pointercancel", stopDrag);

    token.addEventListener("keydown", (event) => {
      const directions = {
        ArrowLeft: [-2, 0],
        ArrowRight: [2, 0],
        ArrowUp: [0, -2],
        ArrowDown: [0, 2],
      };
      if (event.key === "Home") {
        event.preventDefault();
        const initial = defaults.find((player) => player.number === Number(token.dataset.number));
        if (initial) {
          positions[token.dataset.number] = { x: initial.x, y: initial.y };
          render();
          persist();
        }
        return;
      }
      if (!directions[event.key]) return;
      event.preventDefault();
      const [dx, dy] = directions[event.key];
      const point = positions[token.dataset.number];
      positions[token.dataset.number] = {
        x: clamp(point.x + dx, 1.8, 98.2),
        y: clamp(point.y + dy, 4, 96),
      };
      render();
      persist();
    });
  });

  document.querySelector('[data-action="reset"]')?.addEventListener("click", () => {
    positions = Object.fromEntries(defaults.map((player) => [player.number, { x: player.x, y: player.y }]));
    render();
    persist();
    status.textContent = "已恢复默认阵型";
  });

  document.querySelector('[data-action="export"]')?.addEventListener("click", () => {
    const payload = {
      name: "八人制战术板",
      exportedAt: new Date().toISOString(),
      players: defaults.map((player) => ({
        number: player.number,
        role: player.role,
        x: positions[player.number].x,
        y: positions[player.number].y,
      })),
    };
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = "qmpk-tactics.json";
    document.body.append(link);
    link.click();
    window.setTimeout(() => {
      link.remove();
      URL.revokeObjectURL(url);
    }, 1000);
    status.textContent = "已导出战术文件";
  });

  load();
</script>

<style>
  .tactics-page {
    padding-top: clamp(46px, 7vw, 92px);
  }

  .tactics-intro {
    max-width: 780px;
  }

  .tactics-intro h1 {
    margin-top: 12px;
  }

  .tactics-intro .lede {
    margin-top: 18px;
  }

  .tactics-caption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13px;
  }

  .tactics-toolbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(28px, 4vw, 46px);
    padding-bottom: 18px;
    border-bottom: 1px solid var(--rule);
  }

  .tactics-action {
    cursor: pointer;
    font: inherit;
  }

  .btn--quiet {
    background: transparent;
    color: var(--ink);
  }

  .tactics-status {
    margin-left: auto;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .tactics-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    gap: clamp(24px, 5vw, 70px);
    margin-top: clamp(26px, 4vw, 44px);
  }

  .tactics-board-wrap {
    min-width: 0;
  }

  .tactics-board {
    position: relative;
    width: 100%;
    aspect-ratio: 100 / 64;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 28%, transparent);
    background: #4f8d5c;
    box-shadow: 0 20px 45px rgb(16 26 46 / 13%);
    touch-action: none;
    user-select: none;
  }

  .tactics-field,
  .tactics-markings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tactics-field {
    background:
      linear-gradient(90deg, rgb(255 255 255 / 4%) 50%, transparent 50%) 0 0 / 14.285% 100%,
      linear-gradient(90deg, rgb(0 0 0 / 5%) 50%, transparent 50%) 0 0 / 28.57% 100%,
      #4f8d5c;
  }

  .tactics-markings {
    fill: none;
    stroke: rgb(255 255 255 / 77%);
    stroke-width: 0.45;
    vector-effect: non-scaling-stroke;
  }

  .tactics-markings__dot {
    fill: rgb(255 255 255 / 82%);
    stroke: none;
  }

  .tactics-goal {
    position: absolute;
    top: 41%;
    width: 1.9%;
    height: 18%;
    border: 1px solid rgb(255 255 255 / 80%);
    background: rgb(255 255 255 / 12%);
  }

  .tactics-goal--left {
    left: -1px;
    border-left: 0;
  }

  .tactics-goal--right {
    right: -1px;
    border-right: 0;
  }

  .tactics-token {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: clamp(38px, 5.8vw, 58px);
    height: clamp(38px, 5.8vw, 58px);
    padding: 0;
    border: 2px solid var(--paper);
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 4px 9px rgb(16 26 46 / 30%);
    cursor: grab;
    transform: translate(-50%, -50%);
    transition: box-shadow 140ms ease, transform 140ms ease;
    touch-action: none;
  }

  .tactics-token:hover,
  .tactics-token:focus-visible {
    z-index: 3;
    box-shadow: 0 0 0 4px rgb(255 255 255 / 65%), 0 6px 12px rgb(16 26 46 / 35%);
  }

  .tactics-token:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  .tactics-token.is-dragging {
    z-index: 4;
    cursor: grabbing;
    transform: translate(-50%, -50%) scale(1.12);
    box-shadow: 0 0 0 5px rgb(255 255 255 / 60%), 0 10px 18px rgb(16 26 46 / 40%);
  }

  .tactics-token__number {
    font-size: clamp(1.15rem, 2.5vw, 1.65rem);
    line-height: 1;
  }

  .tactics-token__role {
    position: absolute;
    top: calc(100% + 4px);
    padding: 1px 5px;
    border-radius: 2px;
    background: rgb(16 26 46 / 75%);
    color: #fff;
    font-family: var(--cjk);
    font-size: 10px;
    line-height: 1.45;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease;
  }

  .tactics-token:hover .tactics-token__role,
  .tactics-token:focus-visible .tactics-token__role,
  .tactics-token.is-dragging .tactics-token__role {
    opacity: 1;
  }

  .tactics-help {
    margin-top: 11px;
    color: var(--muted);
    font-size: 13px;
  }

  .tactics-notes {
    align-self: start;
    padding-top: 5px;
  }

  .tactics-notes h2 {
    font-size: 1.3rem;
  }

  .tactics-notes ol {
    margin: 16px 0 0;
    padding-left: 1.2em;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.75;
  }

  .tactics-notes li + li {
    margin-top: 7px;
  }

  .tactics-legend {
    display: grid;
    gap: 8px;
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: 13px;
  }

  .tactics-legend .label {
    margin-bottom: 3px;
  }

  .tactics-swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--ink);
    vertical-align: -1px;
  }

  .tactics-swatch--gk {
    background: var(--gold);
  }

  .tactics-swatch--def {
    background: #536b9c;
  }

  .tactics-swatch--mid {
    background: #4f8d5c;
    border: 1px solid var(--ink);
  }

  .tactics-swatch--att {
    background: #a65b52;
  }

  @media (max-width: 800px) {
    .tactics-layout {
      grid-template-columns: 1fr;
    }

    .tactics-notes {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px 28px;
    }

    .tactics-notes ol {
      margin-top: 0;
    }

    .tactics-legend {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }
  }

  @media (max-width: 500px) {
    .tactics-status {
      width: 100%;
      margin-left: 0;
    }

    .tactics-notes {
      display: block;
    }

    .tactics-legend {
      margin-top: 24px;
      padding-top: 18px;
      border-top: 1px solid var(--rule);
    }
  }
</style>
