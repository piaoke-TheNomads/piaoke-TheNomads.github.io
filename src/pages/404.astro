---
import Base from "../layouts/Base.astro";
---

<Base title="页面没找到">
  <section class="wrap">
    <div class="page-head">
      <p class="label page-head__kicker">404</p>
      <h1>页面不存在</h1>
      <p class="lede page-head__dek">
        请求的页面不存在或已被移除。
      </p>
      <p style="margin-top:26px"><a class="btn" href="/">回首页</a></p>
    </div>
  </section>
</Base>
