---
import Base from "../layouts/Base.astro";
import { activeRoster, positionOf } from "../lib/data.js";
import "../styles/tactics.css";
const players = activeRoster.map((p) => ({ id: p.id, number: p.number, name: p.name, position: p.position, positions: p.positions, positionLabel: positionOf(p) || "" }));
---

<Base active="tactics" title="战术板" description="八人制足球战术板，安排站位、保存阵容并分享战术图。">
  <section class="section tactics-page">
    <div class="wrap tactics-wrap">
      <div class="tactics-intro">
        <div><p class="label">Tactics · 八人制</p><h1>战术板</h1></div>
        <p class="tactics-storage" data-save-state>方案保存在当前浏览器</p>
      </div>
      <div class="tactics-planbar">
        <label class="tactics-select-label">方案<select data-plan-select aria-label="选择方案"></select></label>
        <div class="tactics-button-group">
          <button type="button" data-action="new">新建</button>
          <button type="button" data-action="save-as">另存为</button>
          <button type="button" data-action="rename">重命名</button>
          <button type="button" data-action="delete">删除</button>
        </div>
      </div>
      <div class="tactics-controls">
        <label class="tactics-select-label">阵型<select data-formation aria-label="阵型模板"><option value="3-2-2">3–2–2</option><option value="2-3-2">2–3–2</option></select></label>
        <button type="button" data-action="reset">恢复默认阵型</button>
        <button type="button" data-action="undo" disabled>撤销</button>
        <span class="tactics-count" data-count>场上 0 / 8</span>
      </div>
      <div class="tactics-board-wrap">
        <div class="tactics-board" data-board role="group" aria-label="八人制球场" aria-describedby="tactics-help" tabindex="0">
          <div class="tactics-field" aria-hidden="true">
            <svg class="tactics-markings" viewBox="0 0 96 66" preserveAspectRatio="none">
              <!-- 八人制 60m x 40m，1m = 1.5 单位，横纵同尺度 -->
              <rect x="3" y="3" width="90" height="60" />
              <line x1="48" y1="3" x2="48" y2="63" />
              <circle cx="48" cy="33" r="9" />
              <circle class="tactics-markings__dot" cx="48" cy="33" r="0.75" />
              <!-- 大禁区 20m x 6m -->
              <rect x="3" y="18" width="9" height="30" />
              <rect x="84" y="18" width="9" height="30" />
              <!-- 小禁区 10m x 2.5m -->
              <rect x="3" y="25.5" width="3.75" height="15" />
              <rect x="89.25" y="25.5" width="3.75" height="15" />
              <!-- 点球点 距底线 8m -->
              <circle class="tactics-markings__dot" cx="15" cy="33" r="0.75" />
              <circle class="tactics-markings__dot" cx="81" cy="33" r="0.75" />
              <!-- 禁区弧 半径 6m，只画禁区外那一段 -->
              <path d="M12 24.515 A9 9 0 0 1 12 41.485" />
              <path d="M84 24.515 A9 9 0 0 0 84 41.485" />
              <!-- 角弧 半径 1m -->
              <path d="M3 4.5 A1.5 1.5 0 0 0 4.5 3" />
              <path d="M91.5 3 A1.5 1.5 0 0 0 93 4.5" />
              <path d="M4.5 63 A1.5 1.5 0 0 0 3 61.5" />
              <path d="M93 61.5 A1.5 1.5 0 0 0 91.5 63" />
            </svg>
            <span class="tactics-goal tactics-goal--left"></span>
            <span class="tactics-goal tactics-goal--right"></span>
          </div>

          <div class="tactics-onfield" data-onfield></div>
        </div>
        <div class="tactics-selection">
          <span data-selection>选择队员后可安排上场或下场</span>
          <button type="button" data-action="remove" disabled>下场</button>
          <button type="button" data-action="cancel-selection" hidden>取消选择</button>
        </div>
        <p class="tactics-status" role="status" aria-live="polite" aria-atomic="true" data-status></p>
      </div>
      <div class="tactics-bench">
        <div class="tactics-bench-heading"><p class="label">现役队员</p><span>场上最多 8 人</span></div>
        <div class="tactics-bench__list" data-bench></div>
      </div>
      <div class="tactics-footer-controls">
        <button type="button" class="tactics-primary" data-action="image">导出战术图片</button>
        <button type="button" data-action="backup">导出方案备份</button>
        <button type="button" data-action="import">导入方案</button>
        <input type="file" accept=".json,application/json" data-import-file hidden />
      </div>
      <p class="tactics-footnote">方案仅保存在本机的当前浏览器。导出备份后，可在其他设备导入并继续编辑。</p>
      <details class="tactics-help" id="tactics-help"><summary>操作说明</summary><p>拖动队员到球场，覆盖另一名队员可换人或换位。也可先选择替补，再点击场上位置。选中场上队员后，方向键微调站位，Delete 键下场；Shift + 方向键加快移动。切换阵型保留当前队员，恢复默认阵型会重新选人。</p></details>
    </div>
  </section>
  <dialog class="tactics-dialog" data-name-dialog aria-labelledby="plan-dialog-title">
    <form data-name-form>
      <h2 id="plan-dialog-title" data-dialog-title>新建方案</h2>
      <label>方案名称<input data-plan-name type="text" maxlength="60" required autocomplete="off" /></label>
      <p class="tactics-dialog-error" data-name-error role="alert"></p>
      <div class="tactics-dialog-actions"><button type="button" data-action="close-name">取消</button><button type="submit" class="tactics-primary">保存</button></div>
    </form>
  </dialog>
  <dialog class="tactics-dialog tactics-image-dialog" data-image-dialog aria-labelledby="image-dialog-title">
    <h2 id="image-dialog-title">战术图片</h2>
    <p data-image-status role="status" aria-live="polite">正在生成图片…</p>
    <img data-image-preview alt="当前阵容的战术图片预览" hidden />
    <div class="tactics-dialog-actions"><button type="button" data-action="close-image">关闭</button><a data-image-download class="tactics-primary" hidden>下载 PNG</a><button type="button" data-action="share" hidden>分享图片</button></div>
  </dialog>
  <script type="application/json" id="tactics-players" set:html={JSON.stringify(players).replace(/</g, "\\u003c")} />
</Base>
<script>
  import "../scripts/tactics.js";
</script>
