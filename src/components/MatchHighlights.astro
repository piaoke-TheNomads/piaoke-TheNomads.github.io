---
import MatchCard from "./MatchCard.astro";
import { matches } from "../lib/match-data.js";
import "../styles/matches.css";
---
<section class="section section--tight" data-match-highlights>
  <div class="wrap">
    <div class="section__head">
      <div><p class="label">Matches · 比赛</p><h2 style="margin-top:10px">赛程与赛果</h2></div>
      <a class="section__more" href="/matches">全部比赛 →</a>
    </div>
    <div class="match-highlights">
      <div><h3>下一场比赛</h3><div data-next-match><p class="match-empty">{matches.length ? "比赛安排见全部比赛。" : "暂无已确认的后续赛程。"}</p></div></div>
      <div><h3>最近赛果</h3><div data-latest-match><p class="match-empty">{matches.length ? "赛果见全部比赛。" : "尚未收录逐场赛果。"}</p></div></div>
    </div>
    <script type="application/json" data-highlight-records set:html={JSON.stringify(matches).replaceAll("<", "\\u003c")} />
    {matches.map((match) => <template data-highlight-template={match.id}><MatchCard match={match} /></template>)}
  </div>
</section>
<script>
  import { nextMatch, latestResult } from "../lib/matches.js";
  const section = document.querySelector<HTMLElement>("[data-match-highlights]");
  if (section) {
    const records = JSON.parse(section.querySelector("[data-highlight-records]")?.textContent ?? "[]");
    const templates = new Map([...section.querySelectorAll<HTMLTemplateElement>("[data-highlight-template]")].map((template) => [template.dataset.highlightTemplate, template]));
    const update = () => {
      for (const [selector, match, message] of [
        ["[data-next-match]", nextMatch(records), "暂无已确认的后续赛程。"],
        ["[data-latest-match]", latestResult(records), "尚未收录有日期的逐场赛果。"],
      ] as const) {
        const target = section.querySelector<HTMLElement>(selector);
        if (!target) continue;
        const template = match && templates.get(match.id);
        if (template) target.replaceChildren(template.content.cloneNode(true));
        else {
          const empty = document.createElement("p");
          empty.className = "match-empty"; empty.textContent = message;
          target.replaceChildren(empty);
        }
      }
    };
    update();
    window.setInterval(update, 30000);
    window.addEventListener("pageshow", update);
    document.addEventListener("visibilitychange", () => { if (!document.hidden) update(); });
  }
</script>
